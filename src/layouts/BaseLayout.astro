---
import { schemaRegistry } from '~/schemas';

interface Props {
  title: string;
  description: string;
  canonical?: string;
}
const { title, description, canonical } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonicalUrl = canonical ?? `${site}${Astro.url.pathname}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/styles.css" />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="brand">Schema for AI Search</a>
      <nav>
        <a href="/faq-schema-generator">FAQ</a>
        <a href="/product-schema-generator">Product</a>
        <a href="/schema-types">Compare</a>
        <a href="/blog">Blog</a>
        <a href="/cli" class="nav-cli">CLI</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-grid">
        <div class="footer-col">
          <h4>Schema generators</h4>
          <ul>
            {schemaRegistry.map((s) => (
              <li><a href={`/${s.slug}`}>{s.name.replace(/ Schema Generator$/, '')}</a></li>
            ))}
          </ul>
        </div>
        <div class="footer-col">
          <h4>Tools &amp; Reading</h4>
          <ul>
            <li><a href="/cli">schemaguardian CLI</a></li>
            <li><a href="/schema-types">Compare schema types</a></li>
            <li><a href="/blog">Blog</a></li>
            <li><a href="https://github.com/moonye6/faq" rel="noopener">GitHub</a></li>
            <li><a href="https://www.npmjs.com/package/@moonye/schemaguardian" rel="noopener">npm</a></li>
          </ul>
        </div>
        <div class="footer-col footer-about">
          <h4>About</h4>
          <p>
            Built for the AI search era. FAQ and HowTo rich snippets are largely
            deprecated, but structured data remains a primary signal for citation
            in Perplexity, ChatGPT, Gemini, and Google AI Overviews.
          </p>
        </div>
      </div>
      <p class="footer-meta">© {new Date().getFullYear()} faqjsonld.com · MIT licensed</p>
    </footer>
  </body>
</html>
