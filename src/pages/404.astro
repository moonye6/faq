---
import BaseLayout from '~/layouts/BaseLayout.astro';
---
<BaseLayout
  title="Not found"
  description="The page you were looking for could not be found."
>
  <article class="schema-page">
    <header class="schema-hero">
      <h1>404</h1>
      <p class="lede">
        That URL is not one of our schema generators. Try the
        <a href="/">homepage</a> for the full list.
      </p>
    </header>
  </article>
</BaseLayout>
