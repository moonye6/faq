---
import BaseLayout from '~/layouts/BaseLayout.astro';
import SchemaGenerator from '~/components/SchemaGenerator';
import { schemaRegistry, getSchemaBySlug } from '~/schemas';
import { jsonLdEnvelope } from '~/lib/schema-types';

export function getStaticPaths() {
  return schemaRegistry.map((s) => ({
    params: { slug: s.slug },
    props: { schemaId: s.id },
  }));
}

const { slug } = Astro.params;
const schema = getSchemaBySlug(slug!);
if (!schema) {
  return Astro.redirect('/404');
}

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const pageUrl = `${site}/${schema.slug}`;

// Page-level FAQPage JSON-LD (eat our own dog food)
const pageFaqJsonLd = jsonLdEnvelope({
  '@type': 'FAQPage',
  mainEntity: schema.pageFaqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});

// Breadcrumb JSON-LD (one of the most reliably-rendered schema types in 2026)
const breadcrumbJsonLd = jsonLdEnvelope({
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: schema.name, item: pageUrl },
  ],
});

// Pick 4 related schema types (next 4 in the registry, wrapping around)
const idx = schemaRegistry.findIndex((s) => s.id === schema.id);
const related = Array.from({ length: 4 }, (_, i) => {
  const j = (idx + i + 1) % schemaRegistry.length;
  return schemaRegistry[j];
}).filter((s): s is NonNullable<typeof s> => Boolean(s));

// Map schema id to "How X Schema Powers AI Citation" blog post slug (if exists)
const blogPostMap: Record<string, { slug: string; title: string }> = {
  faq: { slug: 'how-faq-schema-powers-ai-citation', title: 'How FAQ Schema Powers AI Search Citation in 2026' },
  product: { slug: 'how-product-schema-powers-ai-citation', title: 'How Product Schema Powers AI Shopping Queries in 2026' },
  breadcrumb: { slug: 'how-breadcrumb-schema-powers-ai-citation', title: 'How Breadcrumb Schema Powers SERP and AI Hierarchy Understanding' },
  localbusiness: { slug: 'how-local-business-schema-powers-ai-citation', title: 'How LocalBusiness Schema Powers AI "Near Me" Answers' },
  video: { slug: 'how-video-schema-powers-ai-citation', title: 'How Video Schema Powers AI Video Discovery in 2026' },
  howto: { slug: 'how-howto-schema-powers-ai-citation', title: 'How HowTo Schema Powers AI Tutorial Citation in 2026' },
  article: { slug: 'how-article-schema-powers-ai-citation', title: 'How Article Schema Powers AI Search Citation in 2026' },
  organization: { slug: 'how-organization-schema-powers-ai-citation', title: 'How Organization Schema Powers AI Brand Attribution' },
};
const relatedPost = blogPostMap[schema.id];
---
<BaseLayout title={schema.title} description={schema.metaDescription}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(pageFaqJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>

  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span aria-hidden="true">›</span>
    <span>{schema.name}</span>
  </nav>

  <article class="schema-page">
    <header class="schema-hero">
      <h1>{schema.h1}</h1>
      <p class="lede">{schema.intro}</p>
    </header>

    <section class="generator-section">
      <SchemaGenerator client:load schemaSlug={schema.slug} />
    </section>

    <aside class="cli-callout">
      <strong>Want to validate this schema in CI?</strong>
      <p>
        After you paste the JSON-LD into your page, run
        <code>npx @moonye/schemaguardian check https://your-page.com --ci</code> to catch
        regressions before deploy. <a href="/cli">See the CLI docs</a>.
      </p>
    </aside>

    <section class="geo-aeo-context">
      <h2>Why this matters in 2026</h2>
      <p>{schema.geoAeoAngle}</p>
    </section>

    {schema.deepContent?.examplesGallery && (
      <section class="examples-gallery">
        <h2>Real-world {schema.name.replace(/ Schema Generator$/, '')} examples</h2>
        <p class="lede">
          Three patterns covering the common cases. Drop-in ready — copy any
          block into your <code>&lt;head&gt;</code> and adapt the values.
        </p>
        {schema.deepContent.examplesGallery.map((ex) => (
          <article class="example-card">
            <h3>{ex.scenario}</h3>
            <p>{ex.description}</p>
            <pre class="install-block"><code>{ex.jsonLd}</code></pre>
          </article>
        ))}
      </section>
    )}

    {schema.deepContent?.platformIntegrations && (
      <section class="platform-integrations">
        <h2>Add {schema.name.replace(/ Schema Generator$/, '')} schema to your platform</h2>
        <p class="lede">
          Platform-specific implementation paths. Pick yours.
        </p>
        {schema.deepContent.platformIntegrations.map((p) => (
          <article class="integration-card">
            <h3>{p.platform}</h3>
            <p>{p.description}</p>
            <ol>
              {p.steps.map((step) => (
                <li>{step}</li>
              ))}
            </ol>
            {p.codeExample && (
              <pre class="install-block"><code>{p.codeExample}</code></pre>
            )}
          </article>
        ))}
      </section>
    )}

    {schema.deepContent?.commonErrors && (
      <section class="common-errors">
        <h2>Common errors that break {schema.name.replace(/ Schema Generator$/, '')} schema</h2>
        <p class="lede">
          The bugs that silently kill rich result eligibility and AI citation.
          Run <code>npx @moonye/schemaguardian check https://your-page.com --ci</code>
          to catch them in CI.
        </p>
        <div class="error-list">
          {schema.deepContent.commonErrors.map((e) => (
            <article class="error-card">
              <h3>{e.error}</h3>
              <p><strong>Why it breaks:</strong> {e.why}</p>
              <p><strong>Fix:</strong> {e.fix}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="page-faq">
      <h2>Common questions about {schema.name}</h2>
      <dl>
        {schema.pageFaqs.map((f) => (
          <div class="faq-item">
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="related-schemas">
      <h2>Related schema generators</h2>
      <ul class="schema-list">
        {related.map((s) => (
          <li>
            <a href={`/${s.slug}`}>
              <strong>{s.name}</strong>
              <span>{s.metaDescription}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="related-resources">
      <h2>Related resources</h2>
      <ul class="related-resource-list">
        {relatedPost && (
          <li>
            <a href={`/blog/${relatedPost.slug}`}>
              <span class="resource-tag">Deep dive</span>
              <strong>{relatedPost.title}</strong>
              <span>How AI search engines extract from {schema.schemaType} markup, and what to do about it in 2026.</span>
            </a>
          </li>
        )}
        <li>
          <a href="/schema-types">
            <span class="resource-tag">Compare</span>
            <strong>Schema type comparison matrix</strong>
            <span>All 13 schema types rated on AI citation value, SERP value, and effort. Decide which to add first.</span>
          </a>
        </li>
        <li>
          <a href="/cli">
            <span class="resource-tag">Validate</span>
            <strong>schemaguardian CLI</strong>
            <span>Validate the JSON-LD you generate above. Free, MIT-licensed, runs in CI. Catches regressions before they ship.</span>
          </a>
        </li>
        <li>
          <a href="/blog">
            <span class="resource-tag">Read</span>
            <strong>All posts on schema and AI search</strong>
            <span>Long-form on GEO, AEO, structured data, and the 2026 reality of schema for AI search citation.</span>
          </a>
        </li>
      </ul>
    </section>
  </article>
</BaseLayout>
