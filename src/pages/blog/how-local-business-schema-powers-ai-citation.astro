---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { jsonLdEnvelope } from '~/lib/schema-types';

const title = 'How LocalBusiness Schema Powers AI "Near Me" Answers in 2026';
const description =
  'LocalBusiness schema feeds Google Map Pack AND drives "best X near me" answers in ChatGPT search and Perplexity. Without LocalBusiness markup, you are invisible to both surfaces. Here is how AI assistants actually parse it.';
const slug = 'how-local-business-schema-powers-ai-citation';
const datePublished = '2026-04-25';
const dateModified = '2026-04-25';
const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://faqjsonld.com';
const url = `${site}/blog/${slug}`;

const articleJsonLd = jsonLdEnvelope({
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished,
  dateModified,
  url,
  mainEntityOfPage: url,
  author: { '@type': 'Organization', name: 'Schema for AI Search', url: site },
  publisher: {
    '@type': 'Organization',
    name: 'Schema for AI Search',
    url: site,
    logo: { '@type': 'ImageObject', url: `${site}/favicon.svg` },
  },
});

const breadcrumbJsonLd = jsonLdEnvelope({
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site}/blog` },
    { '@type': 'ListItem', position: 3, name: title, item: url },
  ],
});

const postFaqs = [
  {
    q: 'Does LocalBusiness schema replace Google Business Profile?',
    a: 'No, they are complementary. Google Business Profile is the canonical signal Google trusts most for local rankings. LocalBusiness schema on your site reinforces that signal AND is what AI assistants (which do not have Google Business Profile API access) parse to surface your business.',
  },
  {
    q: 'Should I use a more specific subtype than LocalBusiness?',
    a: 'Yes whenever possible. Schema.org has 100+ LocalBusiness subtypes: Restaurant, Dentist, AutoRepair, Hotel, Attorney, etc. Specific subtypes unlock subtype-specific rich features (menus for Restaurant, services for medical) AND give AI assistants better classification. "Joe\'s Coffee" with @type=CafeOrCoffeeShop ranks better for "coffee near me" than the same with generic @type=LocalBusiness.',
  },
  {
    q: 'How do AI assistants pick which businesses to cite for "near me" queries?',
    a: 'They combine LocalBusiness schema (your data) with location signals from the user (city/IP/device). Schema with complete address, accurate openingHoursSpecification, real telephone, and reasonable priceRange wins. Schema missing any of these gets filtered out at retrieval.',
  },
  {
    q: 'How important are openingHoursSpecification format and accuracy?',
    a: 'Critical. AI assistants directly answer "is X open right now?" by parsing this field. Wrong format means the answer is wrong, which is worse than no answer — users lose trust in your brand based on bad AI data sourced from your own page.',
  },
  {
    q: 'What about multi-location businesses?',
    a: 'Each location gets its own LocalBusiness page with location-specific schema. Do not stuff multiple addresses into one schema block. Use the parent Organization to link them via sameAs or department fields. Each location page should have a unique address, phone, hours, and ideally locally-themed copy.',
  },
];

const postFaqJsonLd = jsonLdEnvelope({
  '@type': 'FAQPage',
  mainEntity: postFaqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});
---
<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(postFaqJsonLd)} />
  </Fragment>

  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span aria-hidden="true">›</span>
    <a href="/blog">Blog</a>
    <span aria-hidden="true">›</span>
    <span>LocalBusiness &amp; Near-Me Queries</span>
  </nav>

  <article class="blog-post">
    <header class="schema-hero">
      <p class="post-meta">Published 2026-04-25 · ~6 min read · Part 4 of the AI Citation series</p>
      <h1>How LocalBusiness Schema Powers AI "Near Me" Answers in 2026</h1>
      <p class="lede">
        LocalBusiness schema does double duty: it feeds the Google Map
        Pack (the local-3 listing in SERPs) AND it is increasingly cited
        by AI assistants when answering "best X near me" or "open X in
        {`{city}`} right now" queries. Without it, you are invisible to
        both surfaces.
      </p>
    </header>

    <section>
      <h2>What LocalBusiness schema is</h2>
      <p>
        <code>LocalBusiness</code> describes a business with physical
        presence: name, full <code>PostalAddress</code>, telephone,
        opening hours, price range, image, geo coordinates. It has 100+
        subtypes for vertical specialization (Restaurant, Dentist, Hotel,
        Attorney, AutoRepair, etc.). Generate clean LocalBusiness JSON-LD
        with the <a href="/local-business-schema-generator">LocalBusiness
        schema generator</a>.
      </p>
      <p>
        Use the most specific subtype that fits. "Joe's Coffee" gets
        @type=CafeOrCoffeeShop, not the generic LocalBusiness. Specific
        types unlock specific rich features and give better AI
        categorization.
      </p>
    </section>

    <section>
      <h2>The two surfaces it feeds</h2>

      <h3>1. Google Map Pack (still active in 2026)</h3>
      <p>
        Google's Map Pack — the 3-business map result above standard
        organic listings for local queries — uses LocalBusiness schema as
        one input alongside Google Business Profile data, citation
        consistency across the web, and proximity to the searcher.
      </p>
      <p>
        Map Pack rich features that LocalBusiness schema directly enables:
        opening hours display ("Open" / "Closes 9 PM"), price range
        indicator ($$), photo carousel from your <code>image</code> field,
        and a click-to-call from <code>telephone</code>.
      </p>

      <h3>2. AI assistant "near me" answers (new since 2024)</h3>
      <p>
        Perplexity, ChatGPT search, Gemini, and Bing Copilot all answer
        location queries by parsing LocalBusiness schema across candidate
        pages. They do NOT have Google Business Profile API access. Your
        on-site LocalBusiness markup is their primary input.
      </p>
      <p>
        Pages with complete LocalBusiness data get cited disproportionately
        in answers like:
      </p>
      <ul>
        <li>"Best coffee near Union Square that's open late"</li>
        <li>"Dentists in Oakland that take Delta Dental"</li>
        <li>"Affordable yoga studios in San Francisco"</li>
        <li>"24-hour pharmacies near 94105"</li>
      </ul>
    </section>

    <section>
      <h2>How AI assistants extract from LocalBusiness markup</h2>
      <p>
        Example user query: "best coffee shop near Union Square in San
        Francisco that's open right now."
      </p>
      <ol>
        <li>AI retrieves candidate pages (coffee-related results in or near SF)</li>
        <li>For each, parse LocalBusiness JSON-LD → extract address, openingHoursSpecification, aggregateRating</li>
        <li>Filter: address geocoded within ~0.5mi of Union Square + currently within open hours</li>
        <li>Rank: aggregateRating × reviewCount (or similar quality proxy)</li>
        <li>Cite top-N, render answer with map + brief description</li>
      </ol>
      <p>
        Pages without LocalBusiness schema get dropped at step 2. Pages
        with incomplete schema (missing hours, missing geo) get dropped
        at step 3. Without complete data, your business is invisible to
        a fast-growing share of local search traffic.
      </p>
    </section>

    <section>
      <h2>5 things to do for LocalBusiness schema in 2026</h2>
      <ol>
        <li>
          <strong>Generate LocalBusiness schema for every location page</strong>
          using the <a href="/local-business-schema-generator">LocalBusiness
          schema generator</a>. Use the most specific subtype.
        </li>
        <li>
          <strong>Include complete openingHoursSpecification.</strong> Per-day
          entries with opens/closes in 24-hour format. This is what powers
          "is X open right now?" answers.
        </li>
        <li>
          <strong>Add geo coordinates.</strong> AI assistants doing
          radius-based filtering need lat/long. Get them from your Google
          Business Profile or any geocoder.
        </li>
        <li>
          <strong>Pair with <a href="/breadcrumb-schema-generator">BreadcrumbList</a></strong>
          if your location pages live under a hierarchy ("Locations &gt;
          California &gt; San Francisco &gt; Mission District"). The
          breadcrumb reinforces geographic context.
        </li>
        <li>
          <strong>Validate in CI.</strong> Wrong opening hours format
          breaks AI parsing silently — your business stays "always closed"
          to AI even when it's open. Run
          <code>npx @moonye/schemaguardian scan https://your-site.com --ci</code>
          to catch format errors. <a href="/cli">CLI docs</a>.
        </li>
      </ol>
    </section>

    <section class="page-faq">
      <h2>Common questions about LocalBusiness schema</h2>
      <dl>
        {postFaqs.map((f) => (
          <div class="faq-item">
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section>
      <h2>Series next reads</h2>
      <ul>
        <li><a href="/blog/how-faq-schema-powers-ai-citation">How FAQ schema powers AI citation</a></li>
        <li><a href="/blog/how-product-schema-powers-ai-citation">How Product schema powers AI shopping queries</a></li>
        <li><a href="/blog/how-breadcrumb-schema-powers-ai-citation">How Breadcrumb schema powers SERP and AI hierarchy</a></li>
        <li><a href="/blog/how-video-schema-powers-ai-citation">How Video schema powers AI video discovery</a></li>
        <li><a href="/blog/geo-aeo-explained">GEO and AEO Explained</a></li>
      </ul>
    </section>
  </article>
</BaseLayout>
