---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { jsonLdEnvelope } from '~/lib/schema-types';

const title = 'Blog — Schema for AI Search';
const description =
  'Long-form posts on structured data, GEO/AEO, AI search citation, and the 2026 reality of schema.org for SEO.';
const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://faqjsonld.com';

interface Post {
  slug: string;
  title: string;
  description: string;
  datePublished: string;
  readMin: number;
  series?: string;
}

const posts: Post[] = [
  {
    slug: 'how-faq-schema-powers-ai-citation',
    title: 'How FAQ Schema Powers AI Search Citation in 2026',
    description:
      'FAQ schema lost its Google rich snippet in 2023 but became the highest-citation-rate schema type in AI search. Here is exactly how Perplexity, ChatGPT, Gemini, and Google AI Overviews extract from FAQPage markup.',
    datePublished: '2026-04-25',
    readMin: 6,
    series: 'AI Citation series · Part 1',
  },
  {
    slug: 'how-product-schema-powers-ai-citation',
    title: 'How Product Schema Powers AI Shopping Queries in 2026',
    description:
      'Product schema kept its full SERP rich results AND became the primary input for AI shopping search. ChatGPT shopping, Perplexity Pro, and Gemini parse Product JSON-LD to power "best X under $Y" recommendations.',
    datePublished: '2026-04-25',
    readMin: 6,
    series: 'AI Citation series · Part 2',
  },
  {
    slug: 'how-breadcrumb-schema-powers-ai-citation',
    title: 'How Breadcrumb Schema Powers SERP Rich Results and AI Hierarchy Understanding',
    description:
      'BreadcrumbList is the most reliably-rendered schema type in 2026 — visible in nearly every Google SERP — AND it tells AI search engines the topical context of every page on your site.',
    datePublished: '2026-04-25',
    readMin: 5,
    series: 'AI Citation series · Part 3',
  },
  {
    slug: 'how-local-business-schema-powers-ai-citation',
    title: 'How LocalBusiness Schema Powers AI "Near Me" Answers in 2026',
    description:
      'LocalBusiness schema feeds Google Map Pack AND drives "best X near me" answers in ChatGPT search and Perplexity. Without it, you are invisible to both surfaces.',
    datePublished: '2026-04-25',
    readMin: 6,
    series: 'AI Citation series · Part 4',
  },
  {
    slug: 'how-video-schema-powers-ai-citation',
    title: 'How Video Schema Powers AI Video Discovery in 2026',
    description:
      'Video rich results survived the 2023-2026 reductions intact. Gemini and Perplexity Pro increasingly surface video answers, but they cannot watch videos at scale — they extract from VideoObject markup.',
    datePublished: '2026-04-25',
    readMin: 6,
    series: 'AI Citation series · Part 5',
  },
  {
    slug: 'google-faq-deprecation-2026',
    title: 'Google FAQ Schema Deprecation in 2026: What Happened and What to Do',
    description:
      'Google scaled back FAQ rich snippets in August 2023 and cut them by another ~50% in March 2026. Here is exactly what changed and what FAQ schema is actually for now.',
    datePublished: '2026-04-25',
    readMin: 7,
  },
  {
    slug: 'geo-aeo-explained',
    title: 'GEO and AEO Explained: SEO for the AI Search Era',
    description:
      'GEO and AEO are the new acronyms for getting cited in AI search. Here is what they mean, who consumes your content, and which schema types matter for which queries.',
    datePublished: '2026-04-25',
    readMin: 8,
  },
];

const breadcrumbJsonLd = jsonLdEnvelope({
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site}/blog` },
  ],
});

const blogJsonLd = jsonLdEnvelope({
  '@type': 'Blog',
  name: 'Schema for AI Search Blog',
  url: `${site}/blog`,
  description,
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.title,
    description: p.description,
    datePublished: p.datePublished,
    url: `${site}/blog/${p.slug}`,
  })),
});
---
<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(blogJsonLd)} />
  </Fragment>

  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span aria-hidden="true">›</span>
    <span>Blog</span>
  </nav>

  <article class="home">
    <header class="home-hero">
      <h1>Blog</h1>
      <p class="lede">
        Long-form posts on structured data, GEO/AEO, AI search citation,
        and the 2026 reality of schema.org for SEO.
      </p>
    </header>

    <section class="schema-grid">
      <ul class="schema-list">
        {posts.map((p) => (
          <li>
            <a href={`/blog/${p.slug}`}>
              <strong>{p.title}</strong>
              <span>{p.description}</span>
              <span class="post-meta">
                {p.datePublished} · ~{p.readMin} min read{p.series ? ` · ${p.series}` : ''}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </article>
</BaseLayout>
