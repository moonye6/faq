---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { jsonLdEnvelope } from '~/lib/schema-types';

const title = 'schemaguard — JSON-LD CLI for the AI Search Era';
const description =
  'Validate JSON-LD structured data on any URL or HTML file from the command line. CI-friendly. Zero dependencies. Built for the AI search era.';

const breadcrumbJsonLd = jsonLdEnvelope({
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://faqjsonld.com/' },
    { '@type': 'ListItem', position: 2, name: 'schemaguard CLI', item: 'https://faqjsonld.com/cli' },
  ],
});

const softwareJsonLd = jsonLdEnvelope({
  '@type': 'SoftwareApplication',
  name: 'schemaguard',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Cross-platform (Node.js 18+)',
  description,
  url: 'https://faqjsonld.com/cli',
  downloadUrl: 'https://www.npmjs.com/package/schemaguard',
  softwareVersion: '0.1.0',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  author: {
    '@type': 'Organization',
    name: 'Schema for AI Search',
    url: 'https://faqjsonld.com',
  },
});

const pageFaqs = [
  {
    q: 'Is schemaguard free?',
    a: 'Yes. The CLI is open source under MIT and free to install via npm. Paid Pro features (multi-domain monitoring, auto-PR fix, team workflows) are planned but not yet built.',
  },
  {
    q: 'How is this different from Google Rich Results Test or schema.org Markup Validator?',
    a: "Both Google's tool and schema.org's validator are web-only and not scriptable. schemaguard runs in your terminal and CI pipeline, so you can fail a build when structured data regresses. It also bakes in the 2026 reality of which schema types still produce rich results (FAQ + HowTo are largely deprecated; Product, Recipe, BreadcrumbList still work) and emits warnings accordingly.",
  },
  {
    q: 'Does schemaguard support Microdata or RDFa?',
    a: 'Not in v0.1. Only JSON-LD <script> tags are extracted. Microdata and RDFa support are tracked for v0.3+ depending on user demand.',
  },
  {
    q: 'How do I add it to my CI pipeline?',
    a: 'In GitHub Actions: `npx schemaguard check $PREVIEW_URL --ci`. The --ci flag exits non-zero on any error so the workflow fails. See the GitHub Actions example below for the full pattern with Vercel preview URLs.',
  },
  {
    q: "Will it tell me if my schema content matches what's visible on the page?",
    a: 'No, and no automated tool can. Google requires that structured data text match what users see, but verifying that requires rendering the page and comparing visible text to schema text — outside the scope of a static validator. schemaguard checks structural correctness; visible-content matching is a human review step.',
  },
];

const pageFaqJsonLd = jsonLdEnvelope({
  '@type': 'FAQPage',
  mainEntity: pageFaqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});
---
<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(pageFaqJsonLd)} />
  </Fragment>

  <article class="cli-page">
    <header class="schema-hero">
      <h1>schemaguard</h1>
      <p class="lede">
        Validate JSON-LD structured data on any URL or HTML file. CI-friendly.
        Zero dependencies. Built for the AI search era.
      </p>
      <pre class="install-block"><code>npx schemaguard check https://your-site.com</code></pre>
    </header>

    <section>
      <h2>What it does</h2>
      <ul>
        <li>Fetches a URL or reads a local HTML file.</li>
        <li>Extracts every <code>&lt;script type="application/ld+json"&gt;</code> block.</li>
        <li>
          Validates the generic envelope (<code>@context</code>, <code>@type</code>) plus
          per-type required fields for 12 schema types (FAQPage, HowTo, Product, Recipe,
          Article, Review, LocalBusiness, Event, BreadcrumbList, Organization, Course,
          JobPosting).
        </li>
        <li>
          Emits 2026-specific warnings: FAQ rich result deprecation, HowTo removal,
          JobPosting <code>validThrough</code> requirement, BreadcrumbList sequential
          positions, and more.
        </li>
        <li><code>--ci</code> flag: exits non-zero on errors so your pipeline fails.</li>
        <li><code>--json</code> flag: machine-readable output for piping to <code>jq</code>.</li>
      </ul>
    </section>

    <section>
      <h2>Install</h2>
      <pre class="install-block"><code>{`# one-off
npx schemaguard check https://example.com

# global
npm i -g schemaguard
schemaguard check https://example.com

# project dev dependency
npm i -D schemaguard`}</code></pre>
      <p class="hint">Requires Node 18+. Bun and Deno also work.</p>
    </section>

    <section>
      <h2>CI integration</h2>
      <h3>GitHub Actions</h3>
      <pre class="install-block"><code>{`# .github/workflows/schema.yml
name: schema
on: [pull_request]
jobs:
  validate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with: { node-version: '20' }
      - run: npx schemaguard check https://your-preview-url --ci`}</code></pre>

      <h3>GitLab CI</h3>
      <pre class="install-block"><code>{`# .gitlab-ci.yml
schema-check:
  image: node:20
  script:
    - npx schemaguard check $CI_ENVIRONMENT_URL --ci`}</code></pre>

      <h3>package.json script</h3>
      <pre class="install-block"><code>{`{
  "scripts": {
    "schema:check": "schemaguard check https://faqjsonld.com --ci"
  }
}`}</code></pre>
    </section>

    <section>
      <h2>Roadmap</h2>
      <ul>
        <li><strong>v0.1 (now):</strong> <code>check</code> a single URL or file.</li>
        <li><strong>v0.2:</strong> <code>scan</code> entire sites via sitemap, <code>generate</code> prompts.</li>
        <li><strong>v0.3+ (paid Pro):</strong> multi-domain monitoring, auto-PR fix via GitHub API, team features, GitHub Action wrapper.</li>
      </ul>
      <p>The free CLI will always validate any site. Paid tiers add multi-domain operations and automation.</p>
    </section>

    <section class="page-faq">
      <h2>Common questions</h2>
      <dl>
        {pageFaqs.map((f) => (
          <div class="faq-item">
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section>
      <h2>Source</h2>
      <p>
        <a href="https://github.com/moonye6/faq" rel="noopener">github.com/moonye6/faq</a> — the CLI lives under <code>cli/</code>.
        The <a href="/">12 free schema generators on this site</a> use the same schema definitions.
        Issues and PRs welcome.
      </p>
    </section>
  </article>
</BaseLayout>
