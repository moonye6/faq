---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { jsonLdEnvelope } from '~/lib/schema-types';

const title = 'schemaguardian — JSON-LD CLI for the AI Search Era';
const description =
  'Validate JSON-LD structured data on any URL or HTML file from the command line. CI-friendly. Zero dependencies. Built for the AI search era.';

const breadcrumbJsonLd = jsonLdEnvelope({
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://faqjsonld.com/' },
    { '@type': 'ListItem', position: 2, name: 'schemaguardian CLI', item: 'https://faqjsonld.com/cli' },
  ],
});

const softwareJsonLd = jsonLdEnvelope({
  '@type': 'SoftwareApplication',
  name: 'schemaguardian',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Cross-platform (Node.js 18+)',
  description,
  url: 'https://faqjsonld.com/cli',
  downloadUrl: 'https://www.npmjs.com/package/@moonye/schemaguardian',
  softwareVersion: '0.1.0',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  author: {
    '@type': 'Organization',
    name: 'Schema for AI Search',
    url: 'https://faqjsonld.com',
  },
});

const pageFaqs = [
  {
    q: 'Is schemaguardian free?',
    a: 'Yes. The CLI is open source under MIT and free to install via npm. Paid Pro features (multi-domain monitoring, auto-PR fix, team workflows) are planned but not yet built.',
  },
  {
    q: 'How is this different from Google Rich Results Test or schema.org Markup Validator?',
    a: "Both Google's tool and schema.org's validator are web-only and not scriptable. schemaguardian runs in your terminal and CI pipeline, so you can fail a build when structured data regresses. It also bakes in the 2026 reality of which schema types still produce rich results (FAQ + HowTo are largely deprecated; Product, Recipe, BreadcrumbList still work) and emits warnings accordingly.",
  },
  {
    q: 'Does schemaguardian support Microdata or RDFa?',
    a: 'Not in v0.1. Only JSON-LD <script> tags are extracted. Microdata and RDFa support are tracked for v0.3+ depending on user demand.',
  },
  {
    q: 'How do I add it to my CI pipeline?',
    a: 'In GitHub Actions: `npx @moonye/schemaguardian check $PREVIEW_URL --ci`. The --ci flag exits non-zero on any error so the workflow fails. See the GitHub Actions example below for the full pattern with Vercel preview URLs.',
  },
  {
    q: "Will it tell me if my schema content matches what's visible on the page?",
    a: 'No, and no automated tool can. Google requires that structured data text match what users see, but verifying that requires rendering the page and comparing visible text to schema text — outside the scope of a static validator. schemaguardian checks structural correctness; visible-content matching is a human review step.',
  },
];

const pageFaqJsonLd = jsonLdEnvelope({
  '@type': 'FAQPage',
  mainEntity: pageFaqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});
---
<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(pageFaqJsonLd)} />
  </Fragment>

  <article class="cli-page">
    <header class="schema-hero">
      <h1>schemaguardian</h1>
      <p class="badges">
        <a href="https://www.npmjs.com/package/@moonye/schemaguardian" rel="noopener">
          <img src="https://img.shields.io/npm/v/@moonye/schemaguardian?label=npm&color=0d4f3c" alt="npm version" />
        </a>
        <a href="https://www.npmjs.com/package/@moonye/schemaguardian" rel="noopener">
          <img src="https://img.shields.io/npm/dm/@moonye/schemaguardian?color=0d4f3c" alt="npm downloads" />
        </a>
        <a href="https://github.com/moonye6/faq" rel="noopener">
          <img src="https://img.shields.io/github/stars/moonye6/faq?color=0d4f3c" alt="GitHub stars" />
        </a>
      </p>
      <p class="lede">
        Validate JSON-LD structured data on any URL, HTML file, or whole
        site via sitemap. CI-friendly. Zero dependencies. Built for the
        AI search era.
      </p>
      <pre class="install-block"><code>npx @moonye/schemaguardian scan https://your-site.com --ci</code></pre>
    </header>

    <section>
      <h2>Three commands</h2>
      <h3><code>check &lt;url|file&gt;</code> — single page</h3>
      <pre class="install-block"><code>npx @moonye/schemaguardian check https://my-site.com/some-page</code></pre>
      <p>
        Fetches the URL (or reads a local HTML file), extracts every
        <code>&lt;script type="application/ld+json"&gt;</code> block, and validates
        each one against schema.org rules plus 2026 Google rejection patterns.
      </p>

      <h3><code>scan &lt;site-url&gt;</code> — whole site via sitemap</h3>
      <pre class="install-block"><code>npx @moonye/schemaguardian scan https://my-site.com --ci</code></pre>
      <p>
        Auto-discovers <code>/sitemap-index.xml</code>, follows child sitemaps,
        and validates every URL in parallel. Reports per-page status, per-type
        coverage across the site, and pages with no structured data at all.
        Use <code>--limit</code>, <code>--concurrency</code>, and <code>--sitemap</code>
        to tune the run.
      </p>

      <h3><code>init</code> — drop a CI workflow</h3>
      <pre class="install-block"><code>npx @moonye/schemaguardian init --url https://my-site.com</code></pre>
      <p>
        Writes <code>.github/workflows/schemaguardian.yml</code> in your project,
        wired up to run <code>scan</code> on every PR and push. One command, one
        commit, your structured data is now CI-gated.
      </p>
    </section>

    <section>
      <h2>What it validates</h2>
      <ul>
        <li>
          Generic envelope (<code>@context</code>, <code>@type</code>) plus per-type
          required fields for 12 schema types: FAQPage, HowTo, Product, Recipe,
          Article (and BlogPosting, NewsArticle), Review, LocalBusiness, Event,
          BreadcrumbList, Organization, Course, JobPosting.
        </li>
        <li>
          2026-specific Google rejection patterns: FAQ rich result deprecation,
          HowTo removal, JobPosting <code>validThrough</code> requirement,
          BreadcrumbList sequential positions, Article publisher logo for Top
          Stories, Product without offers or aggregateRating, and more.
        </li>
        <li>
          Honest warnings about which schema types still produce SERP rich
          results in 2026 vs. which are now AI-citation-only.
        </li>
      </ul>
    </section>

    <section>
      <h2>Install</h2>
      <pre class="install-block"><code>{`# one-off
npx @moonye/schemaguardian check https://example.com

# global
npm i -g @moonye/schemaguardian
schemaguardian check https://example.com

# project dev dependency
npm i -D @moonye/schemaguardian`}</code></pre>
      <p class="hint">Requires Node 18+. Bun and Deno also work.</p>
    </section>

    <section>
      <h2>CI integration</h2>
      <p>
        Easiest path: <code>npx @moonye/schemaguardian init</code> writes a
        ready-to-commit workflow. Or wire it up by hand:
      </p>

      <h3>GitHub Actions</h3>
      <pre class="install-block"><code>{`# .github/workflows/schemaguardian.yml
name: schemaguardian
on:
  pull_request:
    branches: [main]
  push:
    branches: [main]
jobs:
  schema-check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/setup-node@v4
        with: { node-version: '20' }
      - run: npx --yes @moonye/schemaguardian@latest scan https://your-site.com --ci`}</code></pre>

      <h3>GitLab CI</h3>
      <pre class="install-block"><code>{`# .gitlab-ci.yml
schema-check:
  image: node:20
  script:
    - npx --yes @moonye/schemaguardian@latest scan $CI_ENVIRONMENT_URL --ci`}</code></pre>

      <h3>package.json script</h3>
      <pre class="install-block"><code>{`{
  "scripts": {
    "schema:check": "schemaguardian check https://faqjsonld.com --ci",
    "schema:scan":  "schemaguardian scan  https://faqjsonld.com --ci"
  }
}`}</code></pre>
    </section>

    <section>
      <h2>Roadmap</h2>
      <ul>
        <li><strong>v0.1:</strong> <code>check</code> a single URL or file.</li>
        <li><strong>v0.2 (now):</strong> <code>scan</code> entire sites via sitemap, <code>init</code> for one-shot CI setup.</li>
        <li><strong>v0.3+ (paid Pro, planned):</strong> multi-domain monitoring, auto-PR fix via GitHub API, team workflows, GitHub Action wrapper.</li>
      </ul>
      <p>The free CLI will always validate any site. Paid tiers add multi-domain operations and automation.</p>
    </section>

    <section class="page-faq">
      <h2>Common questions</h2>
      <dl>
        {pageFaqs.map((f) => (
          <div class="faq-item">
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section>
      <h2>Source</h2>
      <p>
        <a href="https://github.com/moonye6/faq" rel="noopener">github.com/moonye6/faq</a> — the CLI lives under <code>cli/</code>.
        The <a href="/">12 free schema generators on this site</a> use the same schema definitions.
        Issues and PRs welcome.
      </p>
    </section>
  </article>
</BaseLayout>
