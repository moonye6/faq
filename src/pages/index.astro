---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { schemaRegistry } from '~/schemas';
import { jsonLdEnvelope } from '~/lib/schema-types';

const title = 'Free Schema Generator for AI Search — FAQ, Product, JSON-LD';
const description =
  'Generate valid JSON-LD structured data that gets cited by ChatGPT, Perplexity, Gemini, and Google AI Overviews. 13 free schema generators. No signup, copy-paste ready.';

const popular = [
  {
    slug: 'faq-schema-generator',
    name: 'FAQ Schema',
    blurb: 'The highest-citation-rate schema type in AI search. Atomic Q&A pairs that AI search engines lift cleanly.',
    primary: true,
  },
  {
    slug: 'product-schema-generator',
    name: 'Product Schema',
    blurb: 'Full SERP rich results in 2026 (price, rating, stock) plus the primary input for AI shopping queries.',
  },
  {
    slug: 'article-schema-generator',
    name: 'Article Schema',
    blurb: 'Author, publisher, date — what AI assistants need to attribute citations to your content correctly.',
  },
];

// 4 / 3 / 6 grouping per design review
const schemaGroups = [
  {
    id: 'content',
    title: 'Content',
    description: 'Editorial pages, articles, FAQs, tutorials, and video. Highest AI-citation leverage.',
    ids: ['faq', 'article', 'howto', 'video'],
  },
  {
    id: 'ecommerce',
    title: 'Ecommerce',
    description: 'Product detail pages, reviews, and recipe content. SERP rich results survived intact.',
    ids: ['product', 'review', 'recipe'],
  },
  {
    id: 'business',
    title: 'Business & discovery',
    description: 'Local businesses, organizations, events, jobs, courses, and breadcrumb hierarchy.',
    ids: ['localbusiness', 'organization', 'event', 'jobposting', 'course', 'breadcrumb'],
  },
];

const homeFaqs = [
  {
    q: 'What is schema markup?',
    a: 'Schema markup is structured data that describes your page content in a way search engines and AI assistants can read. It uses the schema.org vocabulary, encoded as JSON-LD inside a <script> tag in your <head>. With it, your FAQ becomes "this is a question, this is its answer" — explicit, citeable, machine-readable.',
  },
  {
    q: 'Do ChatGPT, Perplexity, and Gemini actually use structured data?',
    a: 'Yes. ChatGPT search, Perplexity, Gemini, and Google AI Overviews all parse JSON-LD when retrieving and citing web pages. Pages with clean schema get cited at notably higher rates than equivalent prose-only pages — the structure removes guesswork for the AI extracting answers.',
  },
  {
    q: 'Is FAQ schema still useful in 2026?',
    a: 'Yes — but for a different reason than 2022. Google restricted FAQ rich snippets to authority sites in 2023 and cut them further in March 2026. The SERP rich result is mostly gone. But FAQ schema is now the highest-citation-rate schema type in AI search. Atomic Q&A pairs are the easiest unit for AI engines to extract and cite cleanly.',
  },
  {
    q: 'How do I add JSON-LD to my site?',
    a: 'Generate the JSON-LD with one of our generators. Copy the output. Paste it inside a <script type="application/ld+json"> tag in the <head> of the page where the matching content lives. That is it — no build step, no API key, no library. Validates with Google Rich Results Test out of the box.',
  },
  {
    q: 'Are these generators really free?',
    a: 'Yes. Every generator on this site is free, no signup, no rate limit, no upsell. The companion schemaguardian CLI is also free under MIT license — npx @moonye/schemaguardian validates your structured data in CI. Source on GitHub.',
  },
  {
    q: 'Do I need a different generator for each schema type?',
    a: 'Yes — each schema.org type has its own required fields and structure. We have 13 generators covering the most common types: FAQ, Product, Article, HowTo, Recipe, Review, LocalBusiness, Event, Breadcrumb, Organization, Course, JobPosting, and Video. Compare them in the schema types matrix to decide which to add first.',
  },
];

const websiteJsonLd = jsonLdEnvelope({
  '@type': 'WebSite',
  name: 'Schema for AI Search',
  url: Astro.site?.toString(),
  description,
});

const homeFaqJsonLd = jsonLdEnvelope({
  '@type': 'FAQPage',
  mainEntity: homeFaqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});

const collectionJsonLd = jsonLdEnvelope({
  '@type': 'CollectionPage',
  name: 'Schema generators',
  description: 'Free JSON-LD schema generators for 13 schema.org types.',
  url: Astro.site?.toString(),
  hasPart: schemaRegistry.map((s) => ({
    '@type': 'WebPage',
    name: s.name,
    url: `${Astro.site?.toString().replace(/\/$/, '')}/${s.slug}`,
    description: s.metaDescription,
  })),
});

// Hero preview JSON-LD (truncated for visual fit)
const heroPreviewJsonLd = `{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [{
    "@type": "Question",
    "name": "How long does shipping take?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "Standard shipping is 3-5 days..."
    }
  }]
}`;
---
<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(homeFaqJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(collectionJsonLd)} />
  </Fragment>

  <article class="home">
    <header class="home-hero-v3">
      <div class="hero-split">
        <div class="hero-left">
          <p class="hero-eyebrow">Built for the AI search era · 2026</p>
          <h1>
            Free Schema Generator for AI Search<br />
            <span class="hero-h1-accent">FAQ, Product, JSON-LD</span>
          </h1>
          <p class="hero-sub">
            Generate valid structured data that gets cited by ChatGPT,
            Perplexity, Gemini, and Google AI Overviews. Copy-paste ready.
          </p>
          <div class="hero-cta-row">
            <a href="/faq-schema-generator" class="cta cta-primary">
              Generate FAQ schema →
            </a>
            <a href="/faq-schema-validator" class="cta cta-secondary">
              Validate existing schema
            </a>
          </div>
          <ul class="trust-badges" aria-label="Trust signals">
            <li>Free forever</li>
            <li>MIT licensed</li>
            <li>No signup</li>
            <li>Google-valid output</li>
          </ul>
        </div>

        <aside class="hero-preview" aria-label="Live preview: input becomes JSON-LD">
          <div class="hero-preview-card">
            <div class="preview-pane preview-input">
              <span class="preview-label">Your Q&amp;A</span>
              <p class="preview-q">Q. How long does shipping take?</p>
              <p class="preview-a">Standard shipping is 3-5 business days within the US.</p>
            </div>
            <div class="preview-arrow" aria-hidden="true">↓</div>
            <div class="preview-pane preview-output">
              <span class="preview-label">JSON-LD output</span>
              <pre><code>{heroPreviewJsonLd}</code></pre>
            </div>
          </div>
        </aside>
      </div>
    </header>

    <section class="popular-section">
      <h2>Most popular</h2>
      <p class="section-subtitle">
        Start here. These three cover the bulk of AI-citation use cases for content sites and ecommerce.
      </p>
      <ul class="popular-grid">
        {popular.map((p) => (
          <li class={`popular-card${p.primary ? ' popular-card-primary' : ''}`}>
            <a href={`/${p.slug}`}>
              <h3>
                {p.name}
                {p.primary && <span class="badge">Most cited in AI</span>}
              </h3>
              <p>{p.blurb}</p>
              <span class="card-cta">Generate {p.name.replace(' Schema', '')} →</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="how-it-works">
      <h2>How it works</h2>
      <ol class="how-steps">
        <li>
          <span class="step-num">1</span>
          <h3>Choose your schema type</h3>
          <p>Pick FAQ, Product, Article, or any of 13 schema.org types matching your content.</p>
        </li>
        <li>
          <span class="step-num">2</span>
          <h3>Fill in your content</h3>
          <p>Paste your real questions, prices, dates. We handle JSON-LD escaping and structure.</p>
        </li>
        <li>
          <span class="step-num">3</span>
          <h3>Copy into <code>&lt;head&gt;</code></h3>
          <p>One <code>&lt;script&gt;</code> tag. No build step, no API key. Validates with Google Rich Results Test.</p>
        </li>
      </ol>
    </section>

    <section class="schema-grid" id="all-generators">
      <h2>All 13 schema generators</h2>
      <p class="section-subtitle">
        Grouped by what your site does.
        <a href="/schema-types">Compare them by AI citation + SERP value →</a>
      </p>

      {schemaGroups.map((group) => (
        <div class="schema-group">
          <header class="schema-group-header">
            <h3>{group.title}</h3>
            <p>{group.description}</p>
          </header>
          <ul class="schema-list">
            {group.ids.map((id) => {
              const s = schemaRegistry.find((sr) => sr.id === id);
              if (!s) return null;
              return (
                <li>
                  <a href={`/${s.slug}`}>
                    <strong>{s.name.replace(/ Schema Generator$/, '')}</strong>
                    <span>{s.metaDescription}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </section>

    <section class="page-faq home-faq">
      <h2>Common questions</h2>
      <dl>
        {homeFaqs.map((f) => (
          <div class="faq-item">
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="from-blog">
      <h2>From the blog</h2>
      <p class="section-subtitle">
        Long-form on structured data, GEO/AEO, and the 2026 reality of schema for AI search.
        <a href="/blog">All posts →</a>
      </p>
      <ul class="blog-tile-list">
        <li>
          <a href="/blog/how-faq-schema-powers-ai-citation">
            <span class="tile-tag">FAQ · AI Citation</span>
            <strong>How FAQ Schema Powers AI Search Citation in 2026</strong>
            <span>The highest-citation-rate schema type in AI search, and how AI engines extract from FAQPage markup.</span>
          </a>
        </li>
        <li>
          <a href="/blog/how-product-schema-powers-ai-citation">
            <span class="tile-tag">Product · AI Shopping</span>
            <strong>How Product Schema Powers AI Shopping Queries</strong>
            <span>Why Product schema kept its SERP rich result AND became the primary input for AI shopping mode.</span>
          </a>
        </li>
        <li>
          <a href="/blog/google-faq-deprecation-2026">
            <span class="tile-tag">Deprecation · Strategy</span>
            <strong>Google FAQ Schema Deprecation in 2026</strong>
            <span>Exactly what changed in 2023 and March 2026, and what FAQ schema is actually for now.</span>
          </a>
        </li>
        <li>
          <a href="/blog/geo-aeo-explained">
            <span class="tile-tag">GEO · AEO</span>
            <strong>GEO and AEO Explained: SEO for AI Search</strong>
            <span>What the new acronyms mean, who consumes your content, and which schema types matter for which queries.</span>
          </a>
        </li>
      </ul>
    </section>

    <section class="cli-hero">
      <h2>Validate in CI: schemaguardian</h2>
      <p>Schema regressions are silent. A botched template change can strip valid markup site-wide without a visible bug. Catch it before it ships:</p>
      <pre class="install-block"><code>npx @moonye/schemaguardian check https://your-site.com --ci</code></pre>
      <p class="hint">
        <a href="/cli">Read the docs</a> · MIT-licensed · Zero dependencies · Node 18+
      </p>
    </section>

    <aside class="founder-note">
      <p>
        Google deprecated FAQ rich snippets in 2023 and HowTo in 2024.
        Schema markup did not lose value, it moved. AI search engines now lean
        on structured data when extracting and citing answers. These 13
        generators and the <a href="/cli">schemaguardian CLI</a> are built
        for that reality.
      </p>
      <p class="founder-sig">
        Building in public ·
        <a href="https://github.com/moonye6/faq" rel="noopener">github.com/moonye6/faq</a> ·
        <a href="/blog/google-faq-deprecation-2026">read the long version →</a>
      </p>
    </aside>
  </article>
</BaseLayout>
