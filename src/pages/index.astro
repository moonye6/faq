---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { schemaRegistry } from '~/schemas';
import { jsonLdEnvelope } from '~/lib/schema-types';

const title = 'Schema Generators for AI Search | FAQ, HowTo, Product, Recipe and 8 more';
const description =
  'Free JSON-LD schema generators built for the AI search era. 12 schema types optimized for citation by Perplexity, ChatGPT, Gemini, and Google AI Overviews. Plus the schemaguardian CLI for CI validation.';

const websiteJsonLd = jsonLdEnvelope({
  '@type': 'WebSite',
  name: 'Schema for AI Search',
  url: Astro.site?.toString(),
  description,
});

const collectionJsonLd = jsonLdEnvelope({
  '@type': 'CollectionPage',
  name: 'Schema generators',
  description: 'Free JSON-LD schema generators for 12 schema.org types.',
  url: Astro.site?.toString(),
  hasPart: schemaRegistry.map((s) => ({
    '@type': 'WebPage',
    name: s.name,
    url: `${Astro.site?.toString().replace(/\/$/, '')}/${s.slug}`,
    description: s.metaDescription,
  })),
});
---
<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(collectionJsonLd)} />
  </Fragment>

  <article class="home">
    <header class="home-hero">
      <h1>Structured Data, Built for AI Search</h1>
      <p class="lede">
        Google scaled back FAQ and HowTo rich results in 2023 and cut them
        further in March 2026. But structured data is now a primary signal
        for AI search citation. These generators are built for that reality.
      </p>
    </header>

    <section class="cli-hero">
      <h2>New: schemaguardian CLI</h2>
      <p>Validate your structured data in CI, before it ships:</p>
      <pre class="install-block"><code>npx @moonye/schemaguardian check https://your-site.com --ci</code></pre>
      <p class="hint">
        <a href="/cli">Read the docs</a> · MIT-licensed · Zero dependencies · Node 18+
      </p>
    </section>

    <section class="schema-grid">
      <h2>12 schema generators</h2>
      <ul class="schema-list">
        {schemaRegistry.map((s) => (
          <li>
            <a href={`/${s.slug}`}>
              <strong>{s.name}</strong>
              <span>{s.metaDescription}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="why">
      <h2>Why we built this</h2>
      <p>
        FAQ and HowTo rich results were the original reason most sites added
        structured data. Google removed HowTo rich results in 2023 and cut FAQ
        rich results to authority sites only, then compressed them further in
        the March 2026 core update.
      </p>
      <p>
        At the same time, AI search consumers (Perplexity, ChatGPT, Gemini,
        Google AI Overviews) lean heavily on structured data when extracting
        and citing answers. The value of schema did not disappear. It moved.
      </p>
      <p>
        These generators output clean, valid JSON-LD aimed at the new
        consumer: large language models indexing the open web for citation.
        The companion <a href="/cli">schemaguardian CLI</a> lets you validate that
        output in CI so regressions never reach production.
      </p>
    </section>
  </article>
</BaseLayout>
